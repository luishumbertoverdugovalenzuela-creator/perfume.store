{{ 'ps-styles.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--ps-color-bg);
  }
  #shopify-section-{{ section.id }} .ps-h2 { text-align: {{ section.settings.text_align }}; }
{% endstyle %}

{%- liquid
  if section.settings.collection != blank
    assign ps_collection = section.settings.collection
  else
    assign ps_collection = collections.all
  endif
-%}

<section class="ps-section ps-dark ps-catalogo">
  <div class="ps-container">
    <div class="ps-catalogo__head ps-reveal">
      <p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ps-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="ps-body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="ps-grid ps-grid--4 ps-catalogo__grid">
      {%- for product in ps_collection.products limit: section.settings.product_count -%}
        <a href="{{ product.url }}" class="ps-prodcard ps-reveal" data-ps-delay="{{ forloop.index0 | times: 60 }}" data-ps-tilt>
          <span class="ps-prodcard__media" data-ps-tilt-target>
            {%- if product.featured_image != blank -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}"
                   alt="{{ product.featured_image.alt | escape }}"
                   width="600" height="600" loading="lazy">
            {%- endif -%}
          </span>
          <span class="ps-prodcard__info">
            {%- if section.settings.show_vendor and product.vendor != blank -%}
              <span class="ps-prodcard__vendor">{{ product.vendor }}</span>
            {%- endif -%}
            <span class="ps-prodcard__title">{{ product.title }}</span>
            <span class="ps-prodcard__price">
              {%- render 'price', product: product, use_variant: false -%}
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_text != blank -%}
      <div class="ps-catalogo__cta ps-reveal">
        <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="ps-btn ps-btn--outline">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-catalogo__head { margin-bottom: 44px; }
  #shopify-section-{{ section.id }} .ps-catalogo__cta { text-align: center; margin-top: 44px; }

  #shopify-section-{{ section.id }} .ps-prodcard {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-top: 2px solid transparent;
    transition: border-color 0.4s var(--ps-ease), transform 0.4s var(--ps-ease);
  }
  #shopify-section-{{ section.id }} .ps-prodcard:hover { border-top-color: var(--ps-color-gold); transform: translateY(-4px); }
  #shopify-section-{{ section.id }} .ps-prodcard__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--ps-color-surface);
    border: 1px solid var(--ps-color-line-dark);
    overflow: hidden;
    transition: transform 0.2s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .ps-prodcard__media::before {
    content: '';
    position: absolute;
    inset: 8%;
    background: radial-gradient(circle, rgba(178, 138, 77, 0.22) 0%, rgba(178, 138, 77, 0) 68%);
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .ps-prodcard__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    z-index: 1;
    filter: drop-shadow(0 26px 20px rgba(0, 0, 0, 0.4));
    transition: transform 0.6s var(--ps-ease);
  }
  #shopify-section-{{ section.id }} .ps-prodcard:hover .ps-prodcard__media img { transform: scale(1.05); }
  #shopify-section-{{ section.id }} .ps-prodcard__info { display: flex; flex-direction: column; gap: 6px; padding: 18px 4px 0; }
  #shopify-section-{{ section.id }} .ps-prodcard__vendor { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ps-color-gold); }
  #shopify-section-{{ section.id }} .ps-prodcard__title { font-size: 15px; line-height: 1.4; color: var(--ps-color-paper); transition: color 0.3s var(--ps-ease); }
  #shopify-section-{{ section.id }} .ps-prodcard:hover .ps-prodcard__title { color: var(--ps-color-gold); }
  #shopify-section-{{ section.id }} .ps-prodcard__price { font-family: var(--ps-font-head); font-size: 16px; color: var(--ps-color-paper); }
  #shopify-section-{{ section.id }} .ps-prodcard__price .price { color: var(--ps-color-paper); }
  #shopify-section-{{ section.id }} .ps-prodcard__price .price { font-family: inherit; }
</style>

{% schema %}
{
  "name": "PS – Catálogo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Nuestra colección" },
    { "type": "text", "id": "title", "label": "Título", "default": "Encuentra tu fragancia" },
    { "type": "textarea", "id": "body", "label": "Texto" },
    { "type": "select", "id": "text_align", "label": "Alineación del título",
      "options": [ {"value":"left","label":"Izquierda"}, {"value":"center","label":"Centro"} ], "default": "center" },
    { "type": "collection", "id": "collection", "label": "Colección a mostrar (vacío = todos los productos)" },
    { "type": "range", "id": "product_count", "label": "Cuántos productos mostrar", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostrar marca", "default": true },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "button_text", "label": "Texto del botón", "default": "Ver todo el catálogo" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "PS – Catálogo" } ]
}
{% endschema %}
