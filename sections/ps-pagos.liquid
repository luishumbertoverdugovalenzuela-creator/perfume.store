{{ 'ps-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--ps-color-bg-alt);
  }
{% endstyle %}

<section class="ps-section ps-dark ps-pagos">
  <div class="ps-container ps-pagos__inner">
    <div class="ps-pagos__copy ps-reveal">
      <p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ps-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="ps-body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="ps-pagos__list ps-reveal" data-ps-delay="100" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="ps-pagos__item">{{ type | payment_type_svg_tag: class: 'ps-pagos__icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ps-pagos__methods ps-reveal" data-ps-delay="120">
        {%- for block in section.blocks -%}
          <div class="ps-pagos__method" {{ block.shopify_attributes }}>
            <h3 class="ps-pagos__method-title">{{ block.settings.title }}</h3>
            {%- if block.settings.detail != blank -%}
              <p class="ps-pagos__method-detail">{{ block.settings.detail | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="ps-pagos__note ps-reveal" data-ps-delay="150">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-pagos__inner { text-align: center; }
  #shopify-section-{{ section.id }} .ps-pagos__copy { max-width: 640px; margin: 0 auto 32px; }
  #shopify-section-{{ section.id }} .ps-eyebrow { justify-content: center; }
  #shopify-section-{{ section.id }} .ps-pagos__list {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 16px; list-style: none; margin: 0 0 32px; padding: 0;
  }
  #shopify-section-{{ section.id }} .ps-pagos__item {
    display: flex; align-items: center; justify-content: center;
    background: var(--ps-color-paper);
    border: 1px solid var(--ps-color-line-dark);
    border-radius: 4px;
    padding: 10px 14px;
    height: 44px;
  }
  #shopify-section-{{ section.id }} .ps-pagos__icon { height: 100%; width: auto; display: block; }
  #shopify-section-{{ section.id }} .ps-pagos__note { margin-top: 24px; font-size: 13px; color: rgba(255, 253, 248, 0.55); }

  #shopify-section-{{ section.id }} .ps-pagos__methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    max-width: 780px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .ps-pagos__method {
    padding: 22px 24px;
    background: var(--ps-color-surface);
    border: 1px solid var(--ps-color-line-dark);
    border-top: 2px solid var(--ps-color-gold);
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ps-pagos__method-title {
    font-family: var(--ps-font-head); font-size: 17px; color: var(--ps-color-gold-light);
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .ps-pagos__method-detail {
    font-size: 14px; line-height: 1.6; color: rgba(255, 253, 248, 0.7); margin: 0;
  }
</style>

{% schema %}
{
  "name": "PS – Métodos de pago",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Compra con confianza" },
    { "type": "text", "id": "title", "label": "Título", "default": "Métodos de pago aceptados" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Paga como prefieras, de forma 100% segura." },
    { "type": "text", "id": "note", "label": "Nota inferior (opcional)", "default": "Todas las transacciones están cifradas y protegidas." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "metodo",
      "name": "Método de pago",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Transferencia bancaria" },
        { "type": "textarea", "id": "detail", "label": "Detalle (banco, CLABE, instrucciones, WhatsApp...)", "default": "Escribe aquí los datos o instrucciones de este método." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PS – Métodos de pago",
      "blocks": [
        { "type": "metodo", "settings": { "title": "Tarjeta de crédito o débito", "detail": "Visa, Mastercard y American Express, procesado de forma segura." } },
        { "type": "metodo", "settings": { "title": "Transferencia bancaria", "detail": "Escribe aquí tu banco, titular y CLABE." } },
        { "type": "metodo", "settings": { "title": "Depósito en efectivo", "detail": "Escribe aquí las instrucciones para depósito en tienda o cajero." } }
      ]
    }
  ]
}
{% endschema %}
