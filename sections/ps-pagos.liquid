{{ 'ps-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--ps-color-bg-alt);
  }
{% endstyle %}

<section class="ps-section ps-dark ps-pagos">
  <div class="ps-container ps-pagos__inner">
    <div class="ps-pagos__copy ps-reveal">
      <p class="ps-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="ps-h2">{{ section.settings.title }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="ps-body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="ps-pagos__list ps-reveal" data-ps-delay="100" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li class="ps-pagos__item" data-ps-tilt>{{ type | payment_type_svg_tag: class: 'ps-pagos__icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <div class="ps-pagos__note ps-reveal" data-ps-delay="150">
        <span class="ps-pagos__note-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <p>{{ section.settings.note }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ps-pagos__inner { text-align: center; }
  #shopify-section-{{ section.id }} .ps-pagos__copy { max-width: 640px; margin: 0 auto 40px; }
  #shopify-section-{{ section.id }} .ps-eyebrow { justify-content: center; }
  #shopify-section-{{ section.id }} .ps-pagos__list {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 18px; list-style: none; margin: 0 0 36px; padding: 0;
  }
  #shopify-section-{{ section.id }} .ps-pagos__item {
    display: flex; align-items: center; justify-content: center;
    background: var(--ps-color-paper);
    border: 1px solid var(--ps-color-line-dark);
    border-radius: 6px;
    padding: 14px 20px;
    height: 52px;
    transition: transform 0.4s var(--ps-ease), box-shadow 0.4s var(--ps-ease), border-color 0.4s var(--ps-ease);
  }
  #shopify-section-{{ section.id }} .ps-pagos__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 34px -20px rgba(178, 138, 77, 0.45);
    border-color: var(--ps-color-gold);
  }
  #shopify-section-{{ section.id }} .ps-pagos__icon { height: 100%; width: auto; display: block; }

  #shopify-section-{{ section.id }} .ps-pagos__note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 auto;
    padding: 14px 26px;
    max-width: 560px;
    background: var(--ps-color-surface);
    border: 1px solid var(--ps-color-line-dark);
    border-radius: 999px;
  }
  #shopify-section-{{ section.id }} .ps-pagos__note-icon { color: var(--ps-color-gold-light); flex-shrink: 0; display: flex; }
  #shopify-section-{{ section.id }} .ps-pagos__note p { margin: 0; font-size: 13px; color: rgba(255, 253, 248, 0.7); text-align: left; }
</style>

{% schema %}
{
  "name": "PS – Métodos de pago",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Compra con confianza" },
    { "type": "text", "id": "title", "label": "Título", "default": "Métodos de pago aceptados" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Paga como prefieras, de forma 100% segura." },
    { "type": "text", "id": "note", "label": "Nota inferior (opcional)", "default": "Todas las transacciones están cifradas y protegidas." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "PS – Métodos de pago" }
  ]
}
{% endschema %}
